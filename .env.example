# Yerelde denemek için bu dosyayı .env adıyla kopyala. Vercel'de aynı adları Environment Variables bölümüne gir.

# Yönetim sayfası (/admin) anahtarı. En az 12 karakter. Boşsa yönetim kapalıdır.
ADMIN_KEY=

# İsteğe bağlı ayarlar (varsayılanlar parantez içinde)
# REPORT_THRESHOLD=3   # kaç farklı ağdan bildirim gelince otomatik engel
# RL_FIND=60           # bir ağın 10 dakikada yapabileceği arama sayısı
